{
  "name": "contextree",
  "displayName": "contextree",
  "description": "La carte du contexte Claude Code en barre latérale : ce qui se charge, quand, et ce qu'il faut vérifier.",
  "version": "2.0.0",
  "publisher": "gengad",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:CLAUDE.md",
    "workspaceContains:AGENTS.md",
    "workspaceContains:.claude/**"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "contextree",
          "name": "contextree",
          "when": "contextree.actif"
        }
      ]
    },
    "commands": [
      {
        "command": "contextree.rafraichir",
        "title": "Rafraîchir la carte",
        "category": "contextree",
        "icon": "$(refresh)"
      },
      {
        "command": "contextree.ouvrirCarte",
        "title": "Carte en texte",
        "category": "contextree",
        "icon": "$(book)"
      },
      {
        "command": "contextree.demander",
        "title": "Demander à Claude",
        "category": "contextree",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "contextree.ouvrirCarte",
          "when": "view == contextree",
          "group": "navigation@1"
        },
        {
          "command": "contextree.rafraichir",
          "when": "view == contextree",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "contextree.demander",
          "when": "view == contextree && viewItem == demandable",
          "group": "inline"
        },
        {
          "command": "contextree.demander",
          "when": "view == contextree && viewItem == demandable",
          "group": "contextree"
        }
      ],
      "commandPalette": [
        {
          "command": "contextree.demander",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "contextree",
      "properties": {
        "contextree.plugin": {
          "type": "string",
          "default": "",
          "description": "Dossier du plugin contextree (celui qui contient skills/carte). Vide : le clone de contextree s'il est ouvert, sinon le plugin installé dans Claude Code."
        }
      }
    }
  }
}
