{
  "name": "contextree-vscode",
  "displayName": "contextree",
  "description": "Voir son arbre de contexte et en éditer la structure, dans l'éditeur.",
  "version": "0.1.0",
  "private": true,
  "publisher": "gengad",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:contextree.tree",
    "workspaceContains:**/.contextree/**"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "contextree.tree",
          "name": "contextree"
        }
      ]
    },
    "commands": [
      {
        "command": "contextree.init",
        "title": "contextree : créer l'arbre de contexte",
        "icon": "$(new-folder)"
      },
      {
        "command": "contextree.wire",
        "title": "contextree : ajouter à une IA",
        "icon": "$(plug)"
      },
      {
        "command": "contextree.copyBootstrap",
        "title": "Copier la consigne pour l'IA",
        "category": "contextree"
      },
      {
        "command": "contextree.openCanvas",
        "title": "contextree : voir l'arbre (toile)",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "contextree.newBranch",
        "title": "contextree : nouvelle branche",
        "icon": "$(add)"
      },
      {
        "command": "contextree.newChild",
        "title": "Nouvelle branche enfant",
        "icon": "$(add)"
      },
      {
        "command": "contextree.rename",
        "title": "Renommer",
        "icon": "$(edit)"
      },
      {
        "command": "contextree.changeType",
        "title": "Changer le type"
      },
      {
        "command": "contextree.move",
        "title": "Déplacer sous un autre parent"
      },
      {
        "command": "contextree.delete",
        "title": "Supprimer",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "contextree.wire",
          "when": "view == contextree.tree",
          "group": "navigation@0"
        },
        {
          "command": "contextree.newBranch",
          "when": "view == contextree.tree && contextree.hasTree",
          "group": "navigation@1"
        },
        {
          "command": "contextree.openCanvas",
          "when": "view == contextree.tree && contextree.hasTree",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "contextree.newChild",
          "when": "view == contextree.tree && viewItem == contextree.branch",
          "group": "inline@0"
        },
        {
          "command": "contextree.newChild",
          "when": "view == contextree.tree && viewItem == contextree.branch",
          "group": "1_structure@0"
        },
        {
          "command": "contextree.rename",
          "when": "view == contextree.tree && viewItem == contextree.branch",
          "group": "1_structure@1"
        },
        {
          "command": "contextree.changeType",
          "when": "view == contextree.tree && viewItem == contextree.branch",
          "group": "1_structure@2"
        },
        {
          "command": "contextree.move",
          "when": "view == contextree.tree && viewItem == contextree.branch",
          "group": "1_structure@3"
        },
        {
          "command": "contextree.delete",
          "when": "view == contextree.tree && viewItem == contextree.branch",
          "group": "2_danger@0"
        },
        {
          "command": "contextree.newBranch",
          "when": "view == contextree.tree && viewItem == contextree.root",
          "group": "1_structure@0"
        }
      ],
      "commandPalette": [
        {
          "command": "contextree.newChild",
          "when": "false"
        },
        {
          "command": "contextree.rename",
          "when": "false"
        },
        {
          "command": "contextree.changeType",
          "when": "false"
        },
        {
          "command": "contextree.move",
          "when": "false"
        },
        {
          "command": "contextree.delete",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "contextree.tree",
        "contents": "Aucun arbre de contexte dans ce dossier — mais ce projet a déjà des consignes pour une IA.\n\nLe plus court est de les lui faire lire : elle écrira l'arbre, tu relis les conditions de chargement.\n[Copier la consigne pour l'IA](command:contextree.copyBootstrap)\nColle-la dans ton assistant. Il écrira 6 à 12 branches et ne touchera à aucun fichier.\n[Créer un arbre vide](command:contextree.init)\n[Ajouter contextree à une IA](command:contextree.wire)",
        "when": "!contextree.hasTree && contextree.hasInstructions"
      },
      {
        "view": "contextree.tree",
        "contents": "Aucun arbre de contexte dans ce dossier.\n\nUn arbre, ce sont de petites branches typées — identité, règles, contexte, références — dont seule la fraction utile est injectée à chaque appel.\n[Créer l'arbre](command:contextree.init)\nQuatre branches de départ, à corriger ensuite comme des fichiers markdown.\n[Copier la consigne pour l'IA](command:contextree.copyBootstrap)\n[Ajouter contextree à une IA](command:contextree.wire)",
        "when": "!contextree.hasTree && !contextree.hasInstructions"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "package": "npx -y @vscode/vsce package --skip-license"
  },
  "devDependencies": {
    "@gengad/contextree": "file:..",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GengAd/contextree.git"
  }
}
